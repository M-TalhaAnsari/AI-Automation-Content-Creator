# =============================================================================
# TrendForge Environment Configuration
# =============================================================================

# LLM Providers (Text & Planning)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_SMALL=openai/gpt-oss-20b
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Trend Research Sources
TAVILY_API_KEY=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TrendForge/1.0
GITHUB_TOKEN=

# Source Toggles
ENABLE_GITHUB=true
ENABLE_REDDIT=true
ENABLE_YOUTUBE=true
ENABLE_GOOGLE_TRENDS=true
ENABLE_HACKERNEWS=true
ENABLE_PAPERSWITHCODE=true
ENABLE_HUGGINGFACE=true
ENABLE_TAVILY=true

# Database & Redis Infrastructure
DATABASE_URL=postgresql://trendforge:trendforge@localhost:5432/trendforge
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Authentication Configuration
# =============================================================================

# JWT Secrets — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_random_256_bit_hex_secret_in_production
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Google OAuth 2.0 — create at console.cloud.google.com
# Set Authorized Redirect URI to: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Frontend URL (used for Google OAuth redirect back to app)
FRONTEND_URL=http://localhost:3000

# Anonymous Trial Limits
MAX_ANON_MESSAGES=3
MAX_ANON_TOKENS=3000

# =============================================================================
# Image Generation Subsystem Configuration
# =============================================================================

# Active Image Provider:
# Options:
#   - "pollinations"   : FREE, FLUX/SDXL via pollinations.ai (no key needed, default)
#   - "huggingface"    : FREE via Hugging Face Inference API (optional HF_TOKEN)
#   - "gemini_imagen"  : Google Imagen 3 / 4 (uses GEMINI_API_KEY)
#   - "mock"           : Synthetic labeled PNG for offline unit testing
IMAGE_PROVIDER=pollinations

# --- Pollinations.ai Settings (FREE) ---
# Models: "flux", "flux-pro", "flux-realism", "turbo", "dreamshaper", "any-dark"
POLLINATIONS_MODEL=flux
POLLINATIONS_TIMEOUT=90
# POLLINATIONS_SEED=42

# --- Hugging Face Settings (FREE / Community) ---
# Free token from https://huggingface.co/settings/tokens
HF_TOKEN=
# Models: "black-forest-labs/FLUX.1-schnell", "stabilityai/stable-diffusion-xl-base-1.0", etc.
HF_MODEL=black-forest-labs/FLUX.1-schnell
HF_TIMEOUT=120

# --- Google Imagen Settings ---
# Models: "imagen-3.0-generate-002", "imagen-4.0-generate-preview-05-20"
IMAGEN_MODEL=imagen-3.0-generate-002

# --- Storage & Queue Settings ---
IMAGE_STORAGE_BACKEND=local
IMAGE_STORAGE_ROOT=storage/images
IMAGE_QUEUE_NAME=trendforge-images
IMAGE_JOB_TIMEOUT=300