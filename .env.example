# ── LLM MODELS ───────────────────────────────────────────────
# Groq — free, fast, LLaMA3 (console.groq.com)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL_SMALL=llama3-8b-8192
GROQ_MODEL_LARGE=llama3-70b-8192

# Gemini — free, best tool calling (aistudio.google.com)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── DATA SOURCES ─────────────────────────────────────────────
# Tavily web search — free 1000/month (tavily.com)
TAVILY_API_KEY=your_tavily_key_here

# YouTube Data API — free 10k units/day (console.cloud.google.com)
YOUTUBE_API_KEY=your_youtube_key_here

# Reddit API — free (reddit.com/prefs/apps → create app)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_secret
REDDIT_USER_AGENT=TrendForge/1.0

# GitHub — free, increases rate limit (github.com/settings/tokens)
GITHUB_TOKEN=your_github_token_here

# ── SOURCE TOGGLES ────────────────────────────────────────────
ENABLE_GITHUB=true
ENABLE_REDDIT=true
ENABLE_YOUTUBE=true
ENABLE_GOOGLE_TRENDS=true
ENABLE_HACKERNEWS=true
ENABLE_PAPERSWITHCODE=true
ENABLE_HUGGINGFACE=true
ENABLE_TAVILY=true

# ── SYSTEM ───────────────────────────────────────────────────
MEMORY_ENABLED=true
SHOW_TOKEN_REPORT=true
SHOW_AGENT_LOGS=false

VITE_API_BASE_URL=