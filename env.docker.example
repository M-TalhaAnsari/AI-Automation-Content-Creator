# Copy this to .env (gitignored, never commit it) in the project root --
# docker-compose.yml's env_file: directive loads it into both the app
# and worker containers.

# Your existing pipeline secrets (already in your local .env today):
GROQ_API_KEY=
GEMINI_API_KEY=

# Per-client API keys (Phase 4). Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_CLIENT_WEB=
# API_CLIENT_SLACK=
# API_CLIENT_MOBILE=

# Session TTL (Phase 3) -- optional, defaults to 24h if omitted
SESSION_TTL_SECONDS=86400

# NOTE on REDIS_URL: deliberately NOT set here. docker-compose.yml's
# `environment:` block hardcodes REDIS_URL=redis://redis:6379/0 for
# both the app and worker services -- that's the correct value INSIDE
# Docker (service name, not localhost). If you also run this project
# directly on your host (no Docker) for local dev, use a separate plain
# .env there with REDIS_URL=redis://localhost:6379/0 instead, matching
# your Phase 3 setup -- don't put a localhost value in THIS file, since
# it would be silently ignored anyway (compose's environment: always
# wins over env_file: for the same key) but is confusing to leave in.
